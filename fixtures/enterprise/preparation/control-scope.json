  "acceptanceCases": [
    {
      "id": "AS1",
      "acceptance": "Current profile through real isolated compiler, engine, capture, both build/review phases and prep-only import accepts only P0-control; verify all required names and zero product writes."
    },
    {
      "id": "AS2",
      "acceptance": "Deleting one current mandatory assertion refuses even when total test count is positive and every executed test passes."
    },
    {
      "id": "AS3",
      "acceptance": "Every retained obligation keeps owner/dependencies/requiredAt; omission, duplicate, unknown or reclassification refuses before capture."
    },
    {
      "id": "AS4",
      "acceptance": "Missing retained history/target assertions can yield bounded control readiness only; P0, R1, H, ENT-101 and product completion remain unavailable."
    },
    {
      "id": "AS5",
      "acceptance": "Any not-ok, cancelled, skipped or todo test in the full command refuses even when its name belongs to retained obligations outside current acceptance."
    },
    {
      "id": "AS6",
      "acceptance": "Caller exclusions, TAP-derived profiles, old profile IDs, changed profile bytes and omitted scope fields cannot create authority."
    },
    {
      "id": "AS7",
      "acceptance": "Old FAILED attempt remains failed under original definitions; new profile requires fresh A_P, current subprocess and a greater attempt ID, never recycled logs."
    },
    {
      "id": "AS8",
      "acceptance": "Candidate, both review phases, canonical report and import must bind identical scope and exact accepted component; P0 alias or broader acceptance refuses."
    },
    {
      "id": "AS9",
      "acceptance": "Old request/receipt/candidate/review schema is preserved as history but rejected as current evidence; no auto-upgrade or journal reset."
    },
    {
      "id": "AS10",
      "acceptance": "Later component profiles retain current mandatory shared controls, add their prerequisites, require fresh A_P/cumulative tests/review and cannot use old acceptance after edits."
    },
    {
      "id": "AS11",
      "acceptance": "Unchanged product B00/all/closure/recovery/selection/seal reject incomplete full obligations and any preparation schema; product state and old failed receipt stay untouched."
    },
    {
      "id": "AS12",
      "acceptance": "Changed profile or authority at execution/publication/review/import awaits refuses; latest FAILED/RUNNING, crash, duplicate terminal and lost-response rules remain enforced."
    }
  ],
